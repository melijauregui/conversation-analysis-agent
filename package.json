{
  "name": "conversation-analysis-agent",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "js-tiktoken": "1.0.21",
    "openai": "7.10.0",
    "sqlite-vec": "0.1.9",
    "zod": "4.5.4"
  },
  "scripts": {
    "ask": "bun scripts/ask-question.ts",
    "data:import": "bun scripts/import-conversations.ts",
    "search:text": "bun scripts/search-text.ts",
    "search:vector": "bun scripts/search-vector.ts",
    "search:hybrid": "bun scripts/search-hybrid.ts",
    "data:profile": "bun ./scripts/phase0.ts profile",
    "eval:prepare": "bun ./scripts/phase0.ts prepare",
    "eval:validate": "bun ./scripts/phase0.ts validate",
    "eval:score": "bun ./scripts/phase0.ts evaluate",
    "test": "bun test",
    "test:integration": "RUN_DEVELOPMENT_INTEGRATION=1 bun test tests/development-integration.test.ts",
    "typecheck": "tsc --noEmit",
    "eval:packets": "bun ./scripts/phase0.ts packets"
  }
}
